# ─── Conexão com o robô ───────────────────────────────────────────────────────
# LocalSTA = robô e API na mesma rede local.
# LocalAP  = o robô é o próprio ponto de acesso; endereço fixo 192.168.12.1, funciona sem roteador e sem internet.
GO2_CONNECTION_METHOD=LocalSTA

# Em LocalSTA, defina UM dos dois abaixo.
#
# O serial funciona bem pois com ele é possível descoberta via multicast
# Sem serial o robô vira cliente DHCP
# NÃO use um endereço 192.168.123.x aqui — essa é a rede interna do
# robô, alcançável só por cabo e sem porta exposta num Pro.
GO2_ROBOT_SERIAL_NUMBER=
GO2_ROBOT_IP=

# Chave AES-128 por dispositivo. O firmware deste robô é anterior
# a 1.1.15 e não a exige (dossiê seção 7.3).
# Se por algum motivo o firmware for atualizado, esse campo se torna necessário
GO2_ROBOT_AES_128_KEY=

# false para subir a API sem tentar conectar ao robô.
GO2_CONNECT_ON_STARTUP=true

# De quanto em quanto tempo a API confere a conexão e, se caiu, tenta reconectar.
GO2_RECONNECT_INTERVAL_S=5.0

# ─── Comportamento de comando ─────────────────────────────────────────────────
# Teto de espera para os comandos que aguardam resposta (só GET /commands/speed).
GO2_REQUEST_TIMEOUT_S=3.0

# Frequência de reenvio interno do comando Move (faixa aceita: 20–50).
GO2_MOVE_RATE_HZ=40.0

# Janela máxima aceita em POST /commands/move.
# O valor está baixo por motivos de segurança
GO2_MOVE_MAX_DURATION_S=3.0

# Limites de velocidade aceitos em POST /commands/move (pedido acima disso → 422).
GO2_MAX_VX=1.0
GO2_MAX_VY=1.0
GO2_MAX_VYAW=2.0

# ─── Servidor HTTP ────────────────────────────────────────────────────────────
# Lidas pelo próprio uvicorn (não têm prefixo GO2_). 0.0.0.0 = aceita pedidos de
# outras máquinas da rede (ex.: a TV Box); 127.0.0.1 = só deste computador.
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8000
